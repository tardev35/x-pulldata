# x-pulldata — คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า (ห้าม commit .env ขึ้น git)
#   cp .env.example .env

# ---- Apify (สแครป X + ตามลิงก์หาโดเมนจริง) ----
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# actor สแครป X (ค่าเริ่มตรงกับที่ใช้ใน n8n)
APIFY_SCRAPER_ACTOR=apidojo/twitter-scraper-lite
# actor ตามลิงก์ (playwright) — เปลี่ยนได้ถ้าคุณใช้ actor อื่น
APIFY_RESOLVER_ACTOR=apify/playwright-scraper
# จำนวนทวีตต่อคีย์เวิร์ดต่อรอบ
MAX_ITEMS=100
# 1 = resolve ทุกลิงก์ผ่าน Apify · 0 (ค่าเริ่ม) = resolve เฉพาะลิงก์สั้น/รวมลิงก์
#     (apidojo คลี่ t.co เป็นโดเมนจริงมาให้แล้ว โดเมนจริงเลยใช้ได้เลย ประหยัดค่า resolver)
RESOLVE_ALL=0

# ---- OpenRouter (สกัดข้อมูลด้วย AI) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# ใส่ให้ตรงกับโมเดลที่ใช้ใน n8n (OpenRouter Chat Model node)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ยิง LLM ขนานกี่เธรด (คอขวดคือรอ network) — ลดลงถ้าโดน 429 จาก OpenRouter
LLM_WORKERS=16

# ทำพร้อมกันกี่คีย์เวิร์ด (Apify Starter รัน actor พร้อมกันได้ 32)
# ค่าใช้จ่ายเท่าเดิม แค่ไม่ต้องรอทีละคิว — 29 คำ: ทีละคำ ~95 นาที · ขนาน 5 ~20 นาที
SCRAPE_WORKERS=5

# ---- Proxy สำหรับ resolver (เว้นว่าง = ใช้ Apify proxy) ----
# ใส่ได้หลายตัวคั่นด้วย comma -> actor หมุนสลับให้ · รูปแบบ http://user:pass@host:port
# เช่น webshare: http://USER-TH-1:PASS@p.webshare.io:80,http://USER-TH-2:PASS@p.webshare.io:80
PROXY_URL=

# ---- โหมดเก็บเอง (collector) ----
# 1 = server วนสแครปคีย์เวิร์ดที่ active เองอัตโนมัติ (ทีละ 5 คำ/รอบ)
COLLECTOR=0
# วินาทีต่อรอบ (ค่าเริ่ม 900 = 15 นาที — สแครปมีค่าใช้จ่าย อย่าถี่เกิน)
COLLECT_CYCLE=900

# ---- เก็บข้อมูลกี่วัน (0 = ไม่ลบทิ้ง) ----
# นับจาก 'วันที่โพสต์' ไม่ใช่วันที่เราเก็บ · server เช็คให้เองทุก 6 ชม.
RETAIN_DAYS=3
