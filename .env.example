# x-pulldata — คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า (ห้าม commit .env ขึ้น git)
#   cp .env.example .env

# ---- Apify (สแครป X + ตามลิงก์หาโดเมนจริง) ----
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# actor สแครป X (ค่าเริ่มตรงกับที่ใช้ใน n8n)
APIFY_SCRAPER_ACTOR=apidojo/twitter-scraper-lite
# actor ตามลิงก์ (playwright) — เปลี่ยนได้ถ้าคุณใช้ actor อื่น
APIFY_RESOLVER_ACTOR=apify/playwright-scraper
# จำนวนทวีตต่อคีย์เวิร์ดต่อรอบ
MAX_ITEMS=100

# ---- OpenRouter (สกัดข้อมูลด้วย AI) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# ใส่ให้ตรงกับโมเดลที่ใช้ใน n8n (OpenRouter Chat Model node)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ---- Residential proxy สำหรับ resolver (เว้นว่าง = ใช้ Apify proxy) ----
# รูปแบบเดียวกับที่ใส่ใน n8n: http://user:pass@host:port
PROXY_URL=

# ---- โหมดเก็บเอง (collector) ----
# 1 = server วนสแครปคีย์เวิร์ดที่ active เองอัตโนมัติ (ทีละ 5 คำ/รอบ)
COLLECTOR=0
# วินาทีต่อรอบ (ค่าเริ่ม 900 = 15 นาที — สแครปมีค่าใช้จ่าย อย่าถี่เกิน)
COLLECT_CYCLE=900

# ---- เก็บข้อมูลกี่วัน (0 = ไม่ลบทิ้ง) ----
RETAIN_DAYS=0
